# Base Configuration - Common Variables for All Countries
# This file is loaded by default for all job executions

# Salesforce (same for all countries)
SF_USER=ops@g.softwareone.com
SF_STAGE_NAME=Cerrada ganada
SF_SKUS=1417,1409,1410,1731,1730,1902,1910,1729,1252,1251,1911,1207,1418,1419,1420,1421,1422
SF_SANDBOX=false
#
# Auth: DOS modos (el extractor usa usuario/contraseña si hay SF_PASSWORD; si no, JWT).
#  (A) Usuario/contraseña (simple; útil si el connected app del JWT no está disponible):
SF_PASSWORD=xxxxxxxxxxxx
# SF_SECURITY_TOKEN=          # solo si el org lo exige (si la IP no está en rango de confianza)
#  (B) JWT (connected app + cert):
SF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-----END PRIVATE KEY-----"
SF_CLIENT_ID=3MVG9XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXIow

# Modo: sandbox (default) -> ip-trabajo-apeinado / billing_raw / billing_views (pruebas).
#       prod             -> proyecto real del país + su export_dataset (de countries.yaml).
ETL_MODE=sandbox
# SANDBOX_PROJECT=ip-trabajo-apeinado   # opcional, override del proyecto sandbox

# Logging (common)
LOG_LEVEL=INFO
ENVIRONMENT=production

# NOTA: la config POR PAÍS (SF_EMPRESA_CODE, project, datasets, currencies) NO va aquí:
# se lee de countries.yaml (raíz del repo). Este .env es solo SECRETOS + modo + comunes.
#
# El periodo (mes/año) se pasa por CLI, no por env:
#   python -m src.etl.jobs.get_billing_accounts --country win_uk --month 5 --year 2026
