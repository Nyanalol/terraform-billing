SF_EMPRESA_CODE=(Empresa_IP__c='0015700001lTrioAAC' OR Empresa_IP__c='001IV00001TJUpHYAX')

# UK-specific: BigQuery Configuration
BQ_PROJECT_ID=ip-trabajo-apeinado
BQ_RAW_DATASET=billing_raw
BQ_TRANSFORMED_DATASET=billing_views
BQ_INPUT_DATASET=billing_views
BQ_WORKSPACE_DATASET=billing_views

