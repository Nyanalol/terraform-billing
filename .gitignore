# Los tfvars por país SÍ se versionan: no llevan secretos (solo project_id, datasets,
# IDs de cuenta y símbolos de divisa) y así el repo es autocontenido para todo el equipo.
# Los secretos reales (JSON keys, HMAC) van en *.json/*.key, ignorados más abajo.

# Logs locales
logs/

# Estado y caché de Terraform
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfplan

# Credenciales y claves
*.json
*.pem
*.key

# Docs HTML de Talend (material de referencia, no versionar)
.talend_docs/

# venv local del ETL
etl/.venv/

# .env del ETL: el base lleva el secreto SF_PRIVATE_KEY (NUNCA versionar).
# La config por país se lee de countries.yaml (no hay .env.<país>); ignoramos cualquier .env.* local.
etl/.env
etl/.env.*
etl/tests/.env.*
!etl/.env.example

# Python bytecode
__pycache__/
*.pyc

# Claude Code (config/sesiones locales, no versionar)
.claude/

# scratch SQL de validacion (no versionar)
etl/mix_and_match/_scratch*
etl/mix_and_match/_*
backups_views/
